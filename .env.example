# ─────────────────────────────────────────────────────────────
# VIG CONNECT 環境変数
# 何も設定しない場合は「デモモード」で起動します（データはブラウザ内に保存）。
# ─────────────────────────────────────────────────────────────

# 公開URL（OGP・sitemap・認証リダイレクトに使用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase（設定すると本番モード：Auth / PostgreSQL / Storage を使用）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。マッチング生成・管理操作で使用。絶対に NEXT_PUBLIC_ を付けない。
SUPABASE_SERVICE_ROLE_KEY=

# 生成AI（名刺読み取り・会社情報の下書き・マッチ理由・紹介文）
# 未設定でもアプリは動作し、ルールベースの文章生成に切り替わります。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_ALLOW_DEMO=false   # デモモード（Supabase未設定）でも生成AIを使う場合のみ true
